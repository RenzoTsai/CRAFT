GEMINI_API_KEY=
OPENAI_API_KEY=

# Deployment model choices; see README for the paper configuration.
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_VISION_MODEL=gemini-flash-lite-latest
GEMINI_DRAFT_MODEL=gemini-pro-latest
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# pupil: Pupil Capture; webcam: computer camera; off: voice/text-only sessions
CRAFT_CAMERA=pupil
CRAFT_PROJECT_ID=my-story
CRAFT_HOST=127.0.0.1
CRAFT_PORT=8000
CRAFT_WEB_PORT=3000
PUPIL_HOST=127.0.0.1
PUPIL_PORT=50020

# Optional fixed location; leave blank to use the system location provider.
CRAFT_LOCATION=
